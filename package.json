{
  "name": "williams-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'PORT=3000 APP_ORIGIN=http://127.0.0.1:5173 tsx watch server/index.ts' 'vite --host 127.0.0.1 --strictPort'",
    "build": "npm run typecheck && vite build && tsup server/index.ts server/cli.ts --format esm --platform node --out-dir dist/server --external better-sqlite3 --external node-ical",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin": "tsx server/cli.ts",
    "setup": "node scripts/setup.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/hedvig-letters-serif": "^5.3.1",
    "@fullcalendar/core": "^7.1.4",
    "@fullcalendar/react": "^7.1.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.70.0",
    "node-ical": "^0.27.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "temporal-polyfill": "^1.0.8",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}

# Public website origin. Use HTTPS behind a reverse proxy in production.
APP_ORIGIN=http://localhost:3000
# Generate a strong password, at least 12 characters. Used only to bootstrap a NEW database.
OWNER_PASSWORD=
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never change this key for an existing database. Back it up separately.
ENCRYPTION_KEY=
# Local development defaults. Docker always uses /data/calendar.sqlite internally.
DATABASE_PATH=data/calendar.sqlite
# Compose binds locally by default; set 0.0.0.0 to expose the port directly.
BIND_ADDRESS=127.0.0.1
PORT=3000
# Only enable if you deliberately need feeds hosted on private networks.
ALLOW_PRIVATE_SOURCES=false
